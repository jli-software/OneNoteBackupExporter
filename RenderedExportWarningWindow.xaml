<Window x:Class="OneNoteExporter.RenderedExportWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="icon.ico"
        Title="Large PDF/XPS export"
        Width="700" Height="555"
        MinWidth="620" MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPage}">

    <Border Margin="18"
            Padding="22"
            Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="TitleText"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryBlue}"/>

            <TextBlock Grid.Row="1"
                       x:Name="ExplanationText"
                       Margin="0,10,0,14"
                       TextWrapping="Wrap"
                       FontSize="13"
                       LineHeight="19"
                       Foreground="{StaticResource TextPrimary}"/>

            <Border Grid.Row="2"
                    Padding="12,10"
                    Background="{StaticResource WarningBg}"
                    BorderBrush="{StaticResource WarningBorder}"
                    BorderThickness="1"
                    CornerRadius="5">
                <TextBlock Text="OneNote does not report a notebook's size through its COM interface, so the app cannot reliably detect a 300 MB notebook before export."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource WarningFg}"/>
            </Border>

            <ScrollViewer Grid.Row="3"
                          Margin="0,16,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="SectionsButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            HorizontalContentAlignment="Left"
                            Padding="14,10"
                            Click="SectionsButton_Click">
                        <StackPanel>
                            <TextBlock Text="Recommended: Export as individual sections"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="SectionsDescriptionText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       FontWeight="Normal"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="OneNotePackageButton"
                            Style="{StaticResource GrayButtonStyle}"
                            Margin="0,8,0,0"
                            HorizontalContentAlignment="Left"
                            Padding="14,9"
                            Click="OneNotePackageButton_Click">
                        <TextBlock x:Name="OneNotePackageButtonText"
                                   Text="Create a complete OneNote package (.onepkg) instead"
                                   TextWrapping="Wrap"/>
                    </Button>

                    <Button x:Name="WholeNotebookButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}"
                            Cursor="Hand"
                            Click="WholeNotebookButton_Click">
                        <TextBlock x:Name="WholeNotebookButtonText"
                                   TextWrapping="Wrap"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="4"
                    Content="Cancel"
                    Style="{StaticResource SmallButtonStyle}"
                    Width="90"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </Grid>
    </Border>
</Window>
