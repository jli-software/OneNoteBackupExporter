<Window x:Class="OneNoteExporter.RenderedExportWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="icon.ico"
        Title="PDF/XPS export"
        Width="640" Height="430"
        MinWidth="580" MinHeight="400"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgPage}">

    <Border Margin="18"
            Padding="22"
            Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       x:Name="TitleText"
                       FontSize="20"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryBlue}"/>

            <TextBlock Grid.Row="1"
                       x:Name="ExplanationText"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       FontSize="14"
                       LineHeight="21"
                       Foreground="{StaticResource TextPrimary}"/>

            <ScrollViewer Grid.Row="2"
                          Margin="0,20,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="SectionsButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Padding="16,12"
                            Click="SectionsButton_Click">
                        <TextBlock Text="Export individual sections (recommended)"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>

                    <Button x:Name="OneNotePackageButton"
                            Style="{StaticResource GrayButtonStyle}"
                            Margin="0,10,0,0"
                            Padding="16,12"
                            Click="OneNotePackageButton_Click">
                        <TextBlock x:Name="OneNotePackageButtonText"
                                   Text="Create a complete OneNote package (.onepkg)"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>

                    <Button x:Name="WholeNotebookButton"
                            Style="{StaticResource GrayButtonStyle}"
                            Margin="0,10,0,0"
                            Padding="16,12"
                            Click="WholeNotebookButton_Click">
                        <TextBlock x:Name="WholeNotebookButtonText"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="3"
                    Content="Cancel"
                    Style="{StaticResource SmallButtonStyle}"
                    Width="90"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
        </Grid>
    </Border>
</Window>
